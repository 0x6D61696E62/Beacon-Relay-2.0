{
  "Lpd": {
    "Port": 515,
    "MaxLineLength": 4096,
    "MaxFileBytes": 52428800,
    "MaxJobBytes": 104857600,
    "MaxFilesPerJob": 16,
    "SessionTimeoutSeconds": 60,
    "InitialRestartBackoffSeconds": 1,
    "MaxRestartBackoffSeconds": 30
  },
  "Storage": {
    "OutputDirectory": "data/inbox"
  },
  "Database": {
    "ConnectionString": "Data Source=db/beacon-relay.db"
  },
  "Deduplication": {
    "Mode": "MarkAndStore"
  },
  "Retention": {
    "Enabled": true,
    "RetentionDays": 30,
    "IntervalMinutes": 60
  },
  "Health": {
    "Port": 8080,
    "HealthPath": "/healthz",
    "ReadinessPath": "/readyz"
  },
  "AdminAuth": {
    "Enabled": false,
    "Username": "admin",
    "Password": "change-me",
    "Realm": "Beacon Relay Admin",
    "SessionMinutes": 480
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
